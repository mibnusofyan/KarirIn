rules_version = '2';

// KarirIn security rules (backend plan section 4.1).
// Each user reads and writes only their own data; the catalogue (jobs, skills) is written only by
// the team's Admin SDK scripts, which bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validStage(s) { return s in ['dikirim', 'tes', 'wawancara', 'diterima', 'ditolak']; }

    match /jobs/{jobId} {
      allow read: if signedIn();
      allow write: if false;

      match /questionSets/{setId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /skills/{skillId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /profiles/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.level in ['smaSmk', 'd3', 's1']
        && request.resource.data.skills is list
        && request.resource.data.skills.size() <= 60;
    }

    // Profile photo as image bytes (no Cloud Storage on the Spark plan); the app resizes it before upload.
    match /profilePhotos/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['image', 'updatedAt'])
        && request.resource.data.image is bytes
        && request.resource.data.image.size() <= 600 * 1024;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      // Applications logged after applying on the company's site: the user sets the status. Lamar cepat
      // applications (quick == true) are sent once with status dikirim; after that only the partner company's
      // recruiter script (Admin SDK) changes them.
      match /applications/{appId} {
        function validApp(d) {
          return validStage(d.status) && d.title is string && d.title.size() <= 120;
        }
        function isQuick(d) { return d.get('quick', false) == true; }
        function validQuick(d) {
          return d.status == 'dikirim'
            && d.letter is string && d.letter.size() <= 8000
            && d.cv.size is int && d.cv.size > 0 && d.cv.size <= 5 * 1024 * 1024
            && d.cv.parts is int && d.cv.parts >= 1 && d.cv.parts <= 6
            && d.consent.text is string && d.consent.text.size() > 0;
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && validApp(request.resource.data)
          && (!isQuick(request.resource.data) || validQuick(request.resource.data));
        allow update: if isOwner(uid)
          && validApp(request.resource.data)
          && !isQuick(resource.data)
          && !isQuick(request.resource.data);

        // The CV copy sent with Lamar cepat, in parts of at most 900 KB (a document holds at most 1 MiB).
        match /cv/{part} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid)
            && part in ['0', '1', '2', '3', '4', '5']
            && isQuick(getAfter(/databases/$(database)/documents/users/$(uid)/applications/$(appId)).data)
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is bytes
            && request.resource.data.data.size() <= 900 * 1024;
          allow update: if false;
        }
      }

      // A finished practice session is written once and never edited.
      match /interviews/{sessionId} {
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }

      match /matches/{jobId} {
        allow read, write: if isOwner(uid);
      }

      // Created by the notify-new-jobs script; the app may only mark them read or delete them.
      match /notifications/{id} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if false;
      }
    }
  }
}
