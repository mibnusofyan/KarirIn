# Copy to backend/.env (gitignored). Never commit the service account file.
# Firebase console → Project settings → Service accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GCLOUD_PROJECT=my-tugas-web

# Interview question drafts (npm run questions -- draft): a free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
