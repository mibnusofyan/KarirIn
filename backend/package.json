{
  "name": "karirin-backend",
  "private": true,
  "type": "module",
  "description": "KarirIn team scripts: seed the Firestore catalogue, interview questions, new-job notifications and the Lamar cepat recruiter.",
  "scripts": {
    "export-data": "cd .. && dart run tool/export_seed.dart",
    "seed": "tsx src/seed.ts",
    "seed:emulator": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=demo-karirin tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/match-score.test.ts",
    "test:rules": "cd .. && firebase emulators:exec --project demo-karirin --only firestore \"npm --prefix backend exec vitest run test/rules.test.ts\"",
    "questions": "tsx src/generate-questions.ts",
    "notify": "tsx src/notify-new-jobs.ts",
    "recruiter": "tsx src/recruiter.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "firebase": "^12.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
